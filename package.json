{
      "name": "zendesk-mcp-server",
      "version": "1.1.0",
      "type": "module",
      "description": "MCP server for Zendesk: read and analyze tickets, conversations and Help Center articles, export tickets, and optionally manage Zendesk data",
      "keywords": [
        "mcp",
        "mcp-server",
        "model-context-protocol",
        "claude",
        "claude-desktop",
        "mcpb",
        "zendesk",
        "zendesk-api",
        "help-center",
        "customer-support"
      ],
      "license": "MIT",
      "author": "N2WS",
      "contributors": [
        {
          "name": "Matt Coatsworth",
          "url": "https://github.com/mattcoatsworth"
        }
      ],
      "repository": {
        "type": "git",
        "url": "git+https://github.com/NikolayChernuhaN2W/zendesk-mcp-server.git"
      },
      "homepage": "https://github.com/NikolayChernuhaN2W/zendesk-mcp-server#readme",
      "bugs": {
        "url": "https://github.com/NikolayChernuhaN2W/zendesk-mcp-server/issues"
      },
      "engines": {
        "node": ">=18"
      },
      "main": "src/index.js",
      "bin": {
        "zendesk-mcp": "src/index.js"
      },
      "scripts": {
        "start": "node src/index.js",
        "dev": "node --watch src/index.js",
        "inspect": "npx -y @modelcontextprotocol/inspector node src/index.js",
        "test": "node --test \"tests/**/*.test.js\"",
        "build:mcpb": "node scripts/release.mjs"
      },
      "dependencies": {
        "@modelcontextprotocol/sdk": "^1.30.0",
        "axios": "^1.6.2",
        "dotenv": "^16.3.1",
        "zod": "^3.25.0"
      },
      "devDependencies": {
        "@anthropic-ai/mcpb": "^2.1.2"
      }
    }
