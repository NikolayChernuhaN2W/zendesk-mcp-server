ZENDESK_SUBDOMAIN=your-subdomain
    ZENDESK_EMAIL=your-email@example.com
    ZENDESK_API_TOKEN=your-api-token

    # Set to true to expose only read tools (no create/update/delete)
    ZENDESK_READ_ONLY=false
    # Set to true to allow create_user/update_user to grant the admin role
    ZENDESK_ALLOW_ADMIN_ROLE=false
